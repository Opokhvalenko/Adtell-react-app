{
	"buildCommand": "npm run build",
	"outputDirectory": "dist",
	"framework": "vite",
	"rewrites": [
		{
			"source": "/api/:path*",
			"destination": "https://addtell-backend.onrender.com/api/:path*"
		},
		{
			"source": "/auth/:path*",
			"destination": "https://addtell-backend.onrender.com/api/auth/:path*"
		},
		{
			"source": "/ads-debug",
			"destination": "https://addtell-backend.onrender.com/ads-debug"
		},
		{
			"source": "/create-lineitem",
			"destination": "https://addtell-backend.onrender.com/create-lineitem"
		},
		{
			"source": "/public/:path*",
			"destination": "https://addtell-backend.onrender.com/public/:path*"
		},
		{
			"source": "/assets/:path*",
			"destination": "https://addtell-backend.onrender.com/assets/:path*"
		},
		{
			"source": "/(.*)",
			"destination": "/"
		}
	],
	"headers": [
		{
			"source": "/(.*)",
			"headers": [
				{
					"key": "Content-Security-Policy",
					"value": "default-src 'self'; script-src 'self' 'unsafe-inline' https:; style-src 'self' 'unsafe-inline' https:; img-src 'self' data: blob: https:; font-src 'self' data: https:; connect-src 'self' https:; frame-src 'self' https: data: blob:; media-src 'self' https: blob:; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests"
				},
				{
					"key": "X-Frame-Options",
					"value": "SAMEORIGIN"
				},
				{
					"key": "X-Content-Type-Options",
					"value": "nosniff"
				},
				{
					"key": "Referrer-Policy",
					"value": "strict-origin-when-cross-origin"
				},
				{
					"key": "Permissions-Policy",
					"value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
				},
				{
					"key": "Cross-Origin-Opener-Policy",
					"value": "same-origin-allow-popups"
				},
				{
					"key": "Access-Control-Allow-Origin",
					"value": "https://adtell-react-app.vercel.app"
				}
			]
		}
	]
}
